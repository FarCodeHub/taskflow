{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch TaskFlow.Tasks.Api (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TaskFlow.Tasks.Api",
      "program": "${workspaceFolder}/src/Services/Tasks/TaskFlow.Tasks.Api/bin/Debug/net10.0/TaskFlow.Tasks.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Services/Tasks/TaskFlow.Tasks.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7058;http://localhost:5006"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Attach to .NET Process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}